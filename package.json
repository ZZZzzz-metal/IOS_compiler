{
  "name": "ipad-offline-debugger",
  "version": "0.2.0",
  "private": true,
  "description": "Local Wasm C/C++ compiler and source debugger integration prototype; iPad validation pending.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node app/main.mjs",
    "check": "node scripts/check-baseline.mjs",
    "test": "node --test contracts/checks/*.test.mjs",
    "test:modules": "node --test compiler/checks/*.test.mjs debugger/checks/*.test.mjs",
    "test:integration": "node --test app/integration/checks/*.test.mjs",
    "demo:integration": "node app/integration/node-demo.mjs",
    "prepare:toolchain": "node compiler/scripts/prepare-toolchain.mjs",
    "prepare:probe": "node compiler/scripts/build-probe.mjs && node debugger/scripts/build-probe.mjs",
    "start:probe": "node debugger/scripts/serve-probe.mjs",
    "module:compiler": "node app/main.mjs compiler",
    "module:debugger": "node app/main.mjs debugger",
    "module:ui": "node app/main.mjs ui",
    "module:storage": "node app/main.mjs storage",
    "module:validation": "node app/main.mjs validation"
  }
}
