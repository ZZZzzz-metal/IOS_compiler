    { "id": "drafts-export", "requirement": "must", "owner": [4, 5], "status": "planned", "scope": "本地保存恢复、失败反馈、导入导出和复制粘贴", "evidence": [] },
    { "id": "ipad-input-and-layout", "requirement": "must", "owner": [4, 5], "status": "planned", "scope": "iPad 键鼠、触控入口、横竖屏/窄窗、中文及切换刷题应用", "evidence": [] },
    { "id": "offline-upgrade-integrity", "requirement": "must", "owner": [1, 4, 5], "status": "planned", "scope": "资源全量校验、原子激活和回退、草稿保护；缺资源不能显示离线可用", "evidence": [] }
